{
  "version": 1,
  "include": ["/*"],
  "exclude": ["/_next/*"],
  "routes": [
    {
      "src": "/challenges",
      "dest": "/challenges.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/tools",
      "dest": "/tools.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
} 